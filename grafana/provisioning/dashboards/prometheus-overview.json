{
    "title": "Dev Environment - Monitoring Overview",
    "uid": "dev-env-overview",
    "tags": [
        "prometheus",
        "dev-environment"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "10s",
    "panels": [
        {
            "id": 1,
            "title": "Monitored Targets Up",
            "type": "stat",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "sum(up)",
                    "legendFormat": "Active Targets",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 2,
            "title": "Firing Alerts",
            "type": "stat",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 8,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)",
                    "legendFormat": "Firing",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 3,
            "title": "Prometheus Go Goroutines",
            "type": "stat",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 16,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "go_goroutines{job=\"prometheus\"}",
                    "legendFormat": "Goroutines",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 4,
            "title": "Scrape Duration (Seconds)",
            "type": "timeseries",
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 6
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "scrape_duration_seconds",
                    "legendFormat": "{{job}} ({{instance}})",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 5,
            "title": "Prometheus Memory Usage (Resident Bytes)",
            "type": "timeseries",
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "process_resident_memory_bytes{job=\"prometheus\"}",
                    "legendFormat": "Resident Memory",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                }
            }
        }
    ]
}